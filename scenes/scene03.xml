<Scene>
    <!-- 相机：从盒子外往里看（康奈尔盒） -->
    <Camera>
        <Position>0, 0.6, -2.58</Position>
        <Target>0, 0.61, 3</Target>
        <Up>0, 1, 0</Up>
        <NearZ>0.1</NearZ>
        <FarZ>1000</FarZ>
        <Fov>45</Fov>
    </Camera>

    <SceneObjects>
        <!-- left sphere -->
        <SceneObject>
            <Transform>
                <Position>-0.4, 0.3, 0.3</Position>
                <Rotation>0, 0, 0</Rotation>
                <Scale>1</Scale>
            </Transform>
            <Primitives>
                <Sphere>
                    <Radius>0.3</Radius>
                </Sphere>
            </Primitives>
        </SceneObject>

        <!-- right sphere -->
        <SceneObject>
            <Transform>
                <Position>0.4, 0.3, -0.3</Position>
                <Rotation>0, 0, 0</Rotation>
                <Scale>1</Scale>
            </Transform>
            <Primitives>
                <Sphere>
                    <Radius>0.3</Radius>
                </Sphere>
            </Primitives>
        </SceneObject>

        <!-- ground：单位四边形绕 X 轴转 -90° 放平（法线朝上） -->
        <SceneObject>
            <Transform>
                <Position>0, 0, 0</Position>
                <Rotation>-90, 0, 0</Rotation>
                <Scale>1</Scale>
            </Transform>
            <Primitives>
                <Triangle>
                    <Vertex>-1, -1, 0</Vertex>
                    <Vertex>1, -1, 0</Vertex>
                    <Vertex>1, 1, 0</Vertex>
                </Triangle>
                <Triangle>
                    <Vertex>-1, -1, 0</Vertex>
                    <Vertex>1, 1, 0</Vertex>
                    <Vertex>-1, 1, 0</Vertex>
                </Triangle>
            </Primitives>
        </SceneObject>

        <!-- ceiling -->
        <SceneObject>
            <Transform>
                <Position>0, 1.5, 0</Position>
                <Rotation>90, 0, 0</Rotation>
                <Scale>1</Scale>
            </Transform>
            <Primitives>
                <Triangle>
                    <Vertex>-1, -1, 0</Vertex>
                    <Vertex>1, -1, 0</Vertex>
                    <Vertex>1, 1, 0</Vertex>
                </Triangle>
                <Triangle>
                    <Vertex>-1, -1, 0</Vertex>
                    <Vertex>1, 1, 0</Vertex>
                    <Vertex>-1, 1, 0</Vertex>
                </Triangle>
            </Primitives>
        </SceneObject>

        <!-- left wall -->
        <SceneObject>
            <Transform>
                <Position>-1, 0.75, 0</Position>
                <Rotation>0, 90, 0</Rotation>
                <Scale>1</Scale>
            </Transform>
            <Primitives>
                <Triangle>
                    <Vertex>-1, -0.75, 0</Vertex>
                    <Vertex>1, -0.75, 0</Vertex>
                    <Vertex>1, 0.75, 0</Vertex>
                </Triangle>
                <Triangle>
                    <Vertex>-1, -0.75, 0</Vertex>
                    <Vertex>1, 0.75, 0</Vertex>
                    <Vertex>-1, 0.75, 0</Vertex>
                </Triangle>
            </Primitives>
        </SceneObject>

        <!-- right wall -->
        <SceneObject>
            <Transform>
                <Position>1, 0.75, 0</Position>
                <Rotation>0, -90, 0</Rotation>
                <Scale>1</Scale>
            </Transform>
            <Primitives>
                <Triangle>
                    <Vertex>-1, -0.75, 0</Vertex>
                    <Vertex>1, -0.75, 0</Vertex>
                    <Vertex>1, 0.75, 0</Vertex>
                </Triangle>
                <Triangle>
                    <Vertex>-1, -0.75, 0</Vertex>
                    <Vertex>1, 0.75, 0</Vertex>
                    <Vertex>-1, 0.75, 0</Vertex>
                </Triangle>
            </Primitives>
        </SceneObject>

        <!-- back wall -->
        <SceneObject>
            <Transform>
                <Position>0, 0.75, 1</Position>
                <Rotation>180, 0, 0</Rotation>
                <Scale>1</Scale>
            </Transform>
            <Primitives>
                <Triangle>
                    <Vertex>-1, -0.75, 0</Vertex>
                    <Vertex>1, -0.75, 0</Vertex>
                    <Vertex>1, 0.75, 0</Vertex>
                </Triangle>
                <Triangle>
                    <Vertex>-1, -0.75, 0</Vertex>
                    <Vertex>1, 0.75, 0</Vertex>
                    <Vertex>-1, 0.75, 0</Vertex>
                </Triangle>
            </Primitives>
        </SceneObject>
    </SceneObjects>

    <Lights>
        <!-- 平行光：方向 (1, -2, 0.4)（将被归一化），斜射 —— 已屏蔽 -->
        <!--<DirectionalLight>
            <Direction>1, -2, 0.4</Direction>
            <Radiance>1, 1, 1</Radiance>
        </DirectionalLight>-->

        <!-- 点光源：盒子内部中央稍上方，距离二次衰减 (A=1, B=0, C=0) -->
        <PointLight>
            <Position>0, 1, 0</Position>
            <Intensity>0.3, 0.3, 1</Intensity>
            <Attenuations>1, 0, 0</Attenuations> <!-- A, B, C -->
        </PointLight>

        <!-- 聚光灯：左侧高处朝右下斜射，内角 10°、外角 60° —— 已屏蔽 -->
        <SpotLight>
            <Position>-0.8, 0.9, 0</Position>
            <Direction>2, -1, 0</Direction>
            <Intensity>1, 1, 1</Intensity>
            <InnerAngle>10</InnerAngle>
            <OuterAngle>60</OuterAngle>
            <Attenuations>1, 0, 0</Attenuations>
        </SpotLight>
    </Lights>
</Scene>
